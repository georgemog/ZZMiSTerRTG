@@ -0,0 +1,78 @@
+#!/usr/bin/env python3
+"""Install the ZZ9000 RTG blitter into a Main_MiSTer source tree.
+
+    zz9000/mister/install.py /path/to/Main_MiSTer
+
+Copies the sources into support/minimig/ and applies three small, idempotent
+edits:
+  Makefile     C_SRC also globs support/minimig/zz9000/*.c (the official
+               ZZ9000OS gfx.c is C and does not build as C++)
+  user_io.cpp  zz9000_stop() next to a2065_stop() when a core is (re)loaded,
+               zz9000_start() next to a2065_start() when Minimig is identified
+Re-running it refreshes the copied files and leaves already-applied edits
+alone.
+"""
+import os
+import shutil
+import sys
+
+HERE = os.path.dirname(os.path.abspath(__file__))
+COMMON = os.path.join(HERE, '..', 'common')
+
+
+def copy(src, dst):
+    os.makedirs(os.path.dirname(dst), exist_ok=True)
+    shutil.copyfile(src, dst)
+    print('  copy', os.path.relpath(dst, TREE))
+
+
+def edit(path, anchor, insert, marker, after=True):
+    with open(path) as f:
+        s = f.read()
+    if marker in s:
+        print('  ok  ', os.path.relpath(path, TREE), '(%s)' % marker.strip())
+        return
+    if s.count(anchor) != 1:
+        sys.exit('error: %s: anchor %r found %d times' % (path, anchor, s.count(anchor)))
+    s = s.replace(anchor, anchor + insert if after else insert + anchor)
+    with open(path, 'w') as f:
+        f.write(s)
+    print('  edit', os.path.relpath(path, TREE), '(%s)' % marker.strip())
+
+
+if len(sys.argv) != 2:
+    sys.exit(__doc__)
+TREE = os.path.abspath(sys.argv[1])
+MM = os.path.join(TREE, 'support', 'minimig')
+if not os.path.isfile(os.path.join(TREE, 'user_io.cpp')) or not os.path.isdir(MM):
+    sys.exit('error: %s does not look like a Main_MiSTer tree' % TREE)
+
+print('Installing ZZ9000 RTG blitter into', TREE)
+copy(os.path.join(HERE, 'minimig_zz9000.cpp'), os.path.join(MM, 'minimig_zz9000.cpp'))
+copy(os.path.join(HERE, 'minimig_zz9000.h'), os.path.join(MM, 'minimig_zz9000.h'))
+ZZ = os.path.join(MM, 'zz9000')
+for name in ('zz9000_blit.c', 'zz9000_fbmem.c', 'zz9000_fbmem.h',
+             'zz9000_service.c', 'zz9000_service.h'):
+    copy(os.path.join(HERE, name), os.path.join(ZZ, name))
+copy(os.path.join(COMMON, 'mister_zz9000.h'), os.path.join(ZZ, 'mister_zz9000.h'))
+for name in sorted(os.listdir(os.path.join(HERE, 'zz9000os'))):
+    copy(os.path.join(HERE, 'zz9000os', name), os.path.join(ZZ, 'zz9000os', name))
+
+edit(os.path.join(TREE, 'Makefile'),
+     'C_SRC =   $(wildcard *.c) \\\n',
+     '          $(wildcard ./support/minimig/zz9000/*.c) \\\n',
+     'support/minimig/zz9000/*.c')
+
+UIO = os.path.join(TREE, 'user_io.cpp')
+edit(UIO, '#include "support/minimig/minimig_a2065.h"\n' if
+     '#include "support/minimig/minimig_a2065.h"\n' in open(UIO).read()
+     else '#include "support.h"\n',
+     '#include "support/minimig/minimig_zz9000.h"\n',
+     'minimig_zz9000.h')
+edit(UIO, '\ta2065_stop();\n',
+     '\n\t// ...and the ZZ9000 RTG blitter thread.\n\tzz9000_stop();\n',
+     'zz9000_stop();')
+edit(UIO, '\t\t\t\t\ta2065_start();\n',
+     '\t\t\t\t\tzz9000_start();\n',
+     'zz9000_start();')
+print('done')
diff --git a/zz9000/mister/minimig_zz9000.cpp b/zz9000/mister/minimig_zz9000.cpp
new file mode 100644
index 00000000..f05a42ad
--- /dev/null
+++ b/zz9000/mister/minimig_zz9000.cpp
@@ -0,0 +1,134 @@
+// ZZ9000-compatible blitter for the Minimig Z3 RTG board - MiSTer glue.
+//
+// Maps the RTG framebuffer window and runs zz9000_service.c from a thread.
+// Polling policy: spin while the Amiga is drawing (ZZ ops are synchronous,
+// so every microsecond of poll latency is a microsecond the 68k stalls),
+// back off to 200us sleeps after a short idle period, and to 20ms while no
+// driver has attached at all.
+
+#include <pthread.h>
+#include <sched.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <time.h>
+#include <unistd.h>
+
+#include "../../shmem.h"
+#include "minimig_zz9000.h"
+#include "zz9000/mister_zz9000.h"
+#include "zz9000/zz9000_service.h"
+
+#define ZZ_SPIN_US        5000     // keep spinning this long after the last op
+#define ZZ_IDLE_SLEEP_US  200      // attached but idle
+#define ZZ_NODRV_SLEEP_US 20000    // no driver: the Amiga handshake waits ~1s
+#define ZZ_HEARTBEAT_US   100000
+
+static pthread_t zz_thread;
+static volatile int zz_running = 0;
+static uint8_t *zz_fb = NULL;
+
+static uint64_t now_us(void)
+{
+	struct timespec ts;
+	clock_gettime(CLOCK_MONOTONIC, &ts);
+	return (uint64_t)ts.tv_sec * 1000000u + ts.tv_nsec / 1000u;
+}
+
+static void *zz_thread_main(void *)
+{
+	struct zz_service s;
+	void *gfx = calloc(1, zz_service_gfxdata_size());
+	if (!gfx) return NULL;
+
+	zz_service_init(&s, zz_fb, MZZ_FB_SIZE, gfx);
+
+	uint64_t last_op = 0, last_hb = 0;
+	int was_attached = 0, warned_swap = 0;
+
+	while (zz_running)
+	{
+		int r = zz_service_poll(&s);
+		uint64_t t = now_us();
+
+		if (r == ZZ_POLL_ATTACHED)
+		{
+			printf("ZZ9000: driver attached (session %08X)\n", s.session);
+			was_attached = 1;
+			last_op = t;
+			continue;
+		}
+		if (r == ZZ_POLL_OP)
+		{
+			last_op = t;
+			continue;
+		}
+
+		if (r == ZZ_POLL_NO_DRIVER)
+		{
+			if (was_attached)
+			{
+				printf("ZZ9000: driver detached after %u ops (%u rejected)\n", s.ops, s.rejected);
+				was_attached = 0;
+			}
+			if (s.swapped && !warned_swap)
+			{
+				printf("ZZ9000: mailbox magic is byte-swapped - core without the RTG byte swap? not attaching\n");
+				warned_swap = 1;
+			}
+			usleep(ZZ_NODRV_SLEEP_US);
+			continue;
+		}
+
+		if (t - last_hb >= ZZ_HEARTBEAT_US)
+		{
+			zz_service_heartbeat(&s);
+			last_hb = t;
+		}
+
+		if (t - last_op < ZZ_SPIN_US) sched_yield();
+		else usleep(ZZ_IDLE_SLEEP_US);
+	}
+
+	free(gfx);
+	return NULL;
+}
+
+void zz9000_stop(void)
+{
+	if (zz_running)
+	{
+		zz_running = 0;
+		pthread_join(zz_thread, NULL);
+	}
+	if (zz_fb)
+	{
+		shmem_unmap(zz_fb, MZZ_FB_SIZE);
+		zz_fb = NULL;
+	}
+}
+
+void zz9000_start(void)
+{
+	zz9000_stop();
+
+	zz_fb = (uint8_t *)shmem_map(MZZ_FB_PHYS, MZZ_FB_SIZE);
+	if (!zz_fb)
+	{
+		printf("ZZ9000: cannot map RTG framebuffer at 0x%08X\n", (unsigned)MZZ_FB_PHYS);
+		return;
+	}
+
+	// DDR3 survives a core reload: drop any stale request so a left-over
+	// mailbox from the previous session is never mistaken for a live driver.
+	*(volatile uint32_t *)(zz_fb + MZZ_MBOX_OFFSET + MZZ_MB_REQ_MAGIC) = 0;
+
+	zz_running = 1;
+	if (pthread_create(&zz_thread, NULL, zz_thread_main, NULL))
+	{
+		zz_running = 0;
+		printf("ZZ9000: cannot start service thread\n");
+		return;
+	}
+	printf("ZZ9000: RTG blitter service started\n");
+}
diff --git a/zz9000/mister/minimig_zz9000.h b/zz9000/mister/minimig_zz9000.h
new file mode 100644
index 00000000..6ae4fc5e
--- /dev/null
+++ b/zz9000/mister/minimig_zz9000.h
@@ -0,0 +1,18 @@
+#ifndef __MINIMIG_ZZ9000_H__
+#define __MINIMIG_ZZ9000_H__
+
+// ZZ9000-compatible blitter for the Minimig Z3 RTG board.
+//
+// The Amiga side is ZZ9000.card (zz9000/amiga) built for MiSTer; it queues
+// ZZ9000 "DMA ops" in a mailbox at the top of the RTG framebuffer. This
+// module runs the official ZZ9000OS blitter on the ARM against that same
+// framebuffer (DDR3 at 0x27000000), from a thread so blits do not wait for
+// the main loop. Protocol: zz9000/common/mister_zz9000.h.
+
+// Start the service thread. Called when the Minimig core is identified.
+void zz9000_start(void);
+
+// Stop the thread and unmap. Called before another core is loaded.
+void zz9000_stop(void);
+
+#endif
diff --git a/zz9000/mister/zz9000_blit.c b/zz9000/mister/zz9000_blit.c
new file mode 100644
index 00000000..77f7ff0d
--- /dev/null
+++ b/zz9000/mister/zz9000_blit.c
@@ -0,0 +1,43 @@
+/*
+ * Build wrapper for the official ZZ9000OS blitter (zz9000os/gfx.c) and its
+ * command dispatcher (zz9000os/dma_rtg.c) inside the MiSTer main binary.
+ *
+ * gfx.c is compiled unmodified; this translation unit only changes the
+ * environment it is compiled in, because its destination memory is the
+ * Strongly-ordered /dev/mem mapping of the RTG framebuffer:
+ *  - memset/memcpy/memmove go to the aligned-access-only zz_fb_* versions;
+ *  - NEON is switched off (the scalar paths only use naturally aligned
+ *    accesses, and the kernel cannot emulate a faulting NEON access);
+ *  - GCC may neither turn loops back into libc calls, merge stores into
+ *    wider, possibly unaligned ones, nor auto-vectorise them into NEON.
+ *
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+#pragma GCC optimize("no-tree-loop-distribute-patterns")
+#pragma GCC optimize("no-store-merging")
+#pragma GCC optimize("no-tree-vectorize")    /* no auto-NEON on Strongly-ordered memory */
+
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <math.h>
+#include "zz9000_fbmem.h"
+
+#undef __ARM_NEON__
+#undef __ARM_NEON
+
+#define memset  zz_fb_memset
+#define memcpy  zz_fb_memcpy
+#define memmove zz_fb_memmove
+
+/* Upstream code, upstream style: keep Main_MiSTer's -Wextra quiet about
+ * the intentional DECODE_PLANAR_PIXEL fall-throughs and unused arguments. */
+#pragma GCC diagnostic push
+#pragma GCC diagnostic ignored "-Wimplicit-fallthrough"
+#pragma GCC diagnostic ignored "-Wunused-parameter"
+#pragma GCC diagnostic ignored "-Wtype-limits"
+#include "zz9000os/gfx.c"
+#pragma GCC diagnostic pop
+
+#include "zz9000os/dma_rtg.c"
diff --git a/zz9000/mister/zz9000_fbmem.c b/zz9000/mister/zz9000_fbmem.c
new file mode 100644
index 00000000..46cb7dcb
--- /dev/null
+++ b/zz9000/mister/zz9000_fbmem.c
@@ -0,0 +1,149 @@
+/*
+ * Framebuffer-safe memset/memcpy/memmove - see zz9000_fbmem.h.
+ *
+ * Misaligned copies use the classic shift-merge: aligned word loads from
+ * the source, two of them combined per aligned destination word. A load
+ * may read up to 3 bytes outside the requested range, but never outside
+ * the aligned word that holds a requested byte, so it cannot cross a page
+ * or the end of the mapping. Little-endian only (ARM and the test host).
+ *
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+#pragma GCC optimize("no-tree-loop-distribute-patterns") /* no memcpy() calls back into libc */
+#pragma GCC optimize("no-store-merging")                 /* no merged, possibly unaligned stores */
+#pragma GCC optimize("no-tree-vectorize")                /* no auto-NEON */
+
+#include <stdint.h>
+#include "zz9000_fbmem.h"
+
+#if __BYTE_ORDER__ != __ORDER_LITTLE_ENDIAN__
+#error zz9000_fbmem.c assumes a little-endian CPU
+#endif
+
+void *zz_fb_memset(void *dst, int c, size_t n)
+{
+	uint8_t *d = (uint8_t *)dst;
+	uint8_t b = (uint8_t)c;
+
+	while (n && ((uintptr_t)d & 3)) {
+		*d++ = b;
+		n--;
+	}
+	if (n >= 4) {
+		uint32_t v = b * 0x01010101u;
+		uint32_t *dw = (uint32_t *)d;
+		while (n >= 32) {
+			dw[0] = v; dw[1] = v; dw[2] = v; dw[3] = v;
+			dw[4] = v; dw[5] = v; dw[6] = v; dw[7] = v;
+			dw += 8;
+			n -= 32;
+		}
+		while (n >= 4) {
+			*dw++ = v;
+			n -= 4;
+		}
+		d = (uint8_t *)dw;
+	}
+	while (n--)
+		*d++ = b;
+	return dst;
+}
+
+static void copy_fwd(uint8_t *d, const uint8_t *s, size_t n)
+{
+	while (n && ((uintptr_t)d & 3)) {
+		*d++ = *s++;
+		n--;
+	}
+	if (n >= 4) {
+		uint32_t *dw = (uint32_t *)d;
+		unsigned k = (uintptr_t)s & 3;
+
+		if (!k) {
+			const uint32_t *sw = (const uint32_t *)s;
+			while (n >= 16) {
+				uint32_t a = sw[0], b = sw[1], c = sw[2], e = sw[3];
+				dw[0] = a; dw[1] = b; dw[2] = c; dw[3] = e;
+				dw += 4;
+				sw += 4;
+				n -= 16;
+			}
+			while (n >= 4) {
+				*dw++ = *sw++;
+				n -= 4;
+			}
+			s = (const uint8_t *)sw;
+		} else {
+			const uint32_t *sw = (const uint32_t *)(s - k);
+			unsigned rs = 8 * k, ls = 32 - rs;
+			uint32_t w0 = *sw++;
+			while (n >= 4) {
+				uint32_t w1 = *sw++;
+				*dw++ = (w0 >> rs) | (w1 << ls);
+				w0 = w1;
+				s += 4;
+				n -= 4;
+			}
+		}
+		d = (uint8_t *)dw;
+	}
+	while (n--)
+		*d++ = *s++;
+}
+
+static void copy_bwd(uint8_t *d, const uint8_t *s, size_t n)
+{
+	d += n;
+	s += n;
+	while (n && ((uintptr_t)d & 3)) {
+		*--d = *--s;
+		n--;
+	}
+	if (n >= 4) {
+		uint32_t *dw = (uint32_t *)d;
+		unsigned k = (uintptr_t)s & 3;
+
+		if (!k) {
+			const uint32_t *sw = (const uint32_t *)s;
+			while (n >= 4) {
+				*--dw = *--sw;
+				n -= 4;
+			}
+			s = (const uint8_t *)sw;
+		} else {
+			const uint32_t *sw = (const uint32_t *)(s - k);
+			unsigned rs = 8 * k, ls = 32 - rs;
+			uint32_t hi = *sw;
+			while (n >= 4) {
+				uint32_t lo = *--sw;
+				*--dw = (lo >> rs) | (hi << ls);
+				hi = lo;
+				s -= 4;
+				n -= 4;
+			}
+		}
+		d = (uint8_t *)dw;
+	}
+	while (n--)
+		*--d = *--s;
+}
+
+void *zz_fb_memcpy(void *dst, const void *src, size_t n)
+{
+	copy_fwd((uint8_t *)dst, (const uint8_t *)src, n);
+	return dst;
+}
+
+void *zz_fb_memmove(void *dst, const void *src, size_t n)
+{
+	uint8_t *d = (uint8_t *)dst;
+	const uint8_t *s = (const uint8_t *)src;
+
+	if (d == s || !n)
+		return dst;
+	if (d < s || d >= s + n)
+		copy_fwd(d, s, n);
+	else
+		copy_bwd(d, s, n);
+	return dst;
+}
diff --git a/zz9000/mister/zz9000_fbmem.h b/zz9000/mister/zz9000_fbmem.h
new file mode 100644
index 00000000..97fdef6f
--- /dev/null
+++ b/zz9000/mister/zz9000_fbmem.h
@@ -0,0 +1,32 @@
+/*
+ * Framebuffer-safe memset/memcpy/memmove for the ZZ9000 blitter on MiSTer.
+ *
+ * The RTG framebuffer is DDR3 above the Linux RAM map, so the /dev/mem
+ * mapping the MiSTer binary gets is Strongly-ordered. ARMv7 faults every
+ * unaligned access to Strongly-ordered/Device memory (the kernel then
+ * emulates it, very slowly), and glibc's string routines freely use
+ * unaligned word accesses. These replacements only ever issue naturally
+ * aligned byte, halfword and word accesses, and use full 32-bit words for
+ * the bulk of every transfer regardless of the source/destination
+ * misalignment.
+ *
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+#ifndef ZZ9000_FBMEM_H
+#define ZZ9000_FBMEM_H
+
+#include <stddef.h>
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+void *zz_fb_memset(void *dst, int c, size_t n);
+void *zz_fb_memcpy(void *dst, const void *src, size_t n);
+void *zz_fb_memmove(void *dst, const void *src, size_t n);
+
+#ifdef __cplusplus
+}
+#endif
+
+#endif
diff --git a/zz9000/mister/zz9000_service.c b/zz9000/mister/zz9000_service.c
new file mode 100644
index 00000000..83b70e22
--- /dev/null
+++ b/zz9000/mister/zz9000_service.c
@@ -0,0 +1,114 @@
+/*
+ * MiSTer side of the ZZ9000-compatible RTG accelerator: mailbox service.
+ * Protocol: common/mister_zz9000.h.
+ *
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+#include <stdint.h>
+#include <string.h>
+
+#include "mister_zz9000.h"
+#include "zz9000_fbmem.h"
+#include "zz9000_service.h"
+#include "zz9000os/gfx.h"
+#include "zz9000os/video.h"
+
+/* Mailbox words are 4-byte aligned, so a plain aligned load/store is safe
+ * on the Strongly-ordered mapping. */
+static inline uint32_t mb_rd(const struct zz_service *s, uint32_t field)
+{
+	return __builtin_bswap32(*(volatile uint32_t *)(s->fb + MZZ_MBOX_OFFSET + field));
+}
+
+static inline void mb_wr(struct zz_service *s, uint32_t field, uint32_t v)
+{
+	*(volatile uint32_t *)(s->fb + MZZ_MBOX_OFFSET + field) = __builtin_bswap32(v);
+}
+
+unsigned zz_service_gfxdata_size(void)
+{
+	return sizeof(struct GFXData);
+}
+
+void zz_service_init(struct zz_service *s, uint8_t *fb, uint32_t fb_size, void *gfxdata)
+{
+	memset(s, 0, sizeof(*s));
+	s->fb = fb;
+	s->fb_size = fb_size;
+	s->gfxdata = gfxdata;
+}
+
+static int op_supported(uint32_t op)
+{
+	return op < 32 && (MZZ_CAPS_V1 & (1UL << op));
+}
+
+int zz_service_poll(struct zz_service *s)
+{
+	uint32_t magic = mb_rd(s, MZZ_MB_REQ_MAGIC);
+
+	if (magic != MZZ_REQ_MAGIC) {
+		/* 'ZM9Z': the 68k's words reached DDR3 byte-swapped, i.e. the core
+		 * does not have the RTG byte swap this port depends on. */
+		s->swapped = (magic == 0x5A4D395AUL);
+		s->attached = 0;
+		return ZZ_POLL_NO_DRIVER;
+	}
+
+	uint32_t session = mb_rd(s, MZZ_MB_SESSION);
+	if (!s->attached || session != s->session) {
+		s->session = session;
+		s->done = mb_rd(s, MZZ_MB_KICK);
+		s->attached = 1;
+		s->ops = s->rejected = 0;
+		mb_wr(s, MZZ_MB_VERSION, MZZ_PROTOCOL_VERSION);
+		mb_wr(s, MZZ_MB_CAPS, MZZ_CAPS_V1);
+		mb_wr(s, MZZ_MB_TAKEN, s->done);
+		mb_wr(s, MZZ_MB_DONE, s->done);
+		mb_wr(s, MZZ_MB_OPS, 0);
+		mb_wr(s, MZZ_MB_REJECTED, 0);
+		__sync_synchronize();
+		mb_wr(s, MZZ_MB_ACK_SESSION, session);
+		mb_wr(s, MZZ_MB_ACK_MAGIC, MZZ_ACK_MAGIC);
+		return ZZ_POLL_ATTACHED;
+	}
+
+	uint32_t kick = mb_rd(s, MZZ_MB_KICK);
+	if (kick == s->done)
+		return ZZ_POLL_IDLE;
+
+	uint32_t op = mb_rd(s, MZZ_MB_OP);
+	mb_wr(s, MZZ_MB_TAKEN, kick);
+
+	if (op_supported(op)) {
+		struct ZZ_VIDEO_STATE vs;
+
+		/* Snapshot only the command header; the dispatcher byte-swaps its
+		 * fields in place (upstream behaviour), which must never touch the
+		 * Amiga's copy. */
+		zz_fb_memcpy(s->gfxdata, s->fb + MZZ_GFXDATA_OFFSET, MZZ_GFXDATA_HEADER);
+		vs.framebuffer = (uint32_t *)s->fb;
+		vs.fb_size = s->fb_size;
+		vs.gfxdata = (struct GFXData *)s->gfxdata;
+		handle_blitter_dma_op(&vs, (uint16_t)op);
+		s->ops++;
+		mb_wr(s, MZZ_MB_OPS, s->ops);
+	} else {
+		s->rejected++;
+		mb_wr(s, MZZ_MB_REJECTED, s->rejected);
+	}
+	s->last_op = (uint16_t)op;
+
+	/* Every pixel store must be visible in DDR3 before the 68k sees DONE. */
+	__sync_synchronize();
+	mb_wr(s, MZZ_MB_DONE, kick);
+	s->done = kick;
+	return ZZ_POLL_OP;
+}
+
+void zz_service_heartbeat(struct zz_service *s)
+{
+	if (!s->attached)
+		return;
+	mb_wr(s, MZZ_MB_HEARTBEAT, ++s->heartbeat);
+}
diff --git a/zz9000/mister/zz9000_service.h b/zz9000/mister/zz9000_service.h
new file mode 100644
index 00000000..6ae9f634
--- /dev/null
+++ b/zz9000/mister/zz9000_service.h
@@ -0,0 +1,54 @@
+/*
+ * MiSTer side of the ZZ9000-compatible RTG accelerator: mailbox service.
+ *
+ * Pure function of a mapped RTG window, so the same code runs in the MiSTer
+ * main binary (minimig_zz9000.cpp maps /dev/mem and calls it from a thread)
+ * and in the host test harness (tests/, plain malloc'd buffer).
+ *
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+#ifndef ZZ9000_SERVICE_H
+#define ZZ9000_SERVICE_H
+
+#include <stdint.h>
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+enum zz_poll_result {
+	ZZ_POLL_NO_DRIVER = -1,   /* no REQ_MAGIC: Amiga driver not running */
+	ZZ_POLL_IDLE      = 0,
+	ZZ_POLL_ATTACHED  = 1,    /* attached to a new driver session */
+	ZZ_POLL_OP        = 2,    /* executed one op */
+};
+
+struct zz_service {
+	uint8_t  *fb;             /* RTG board offset 0 */
+	uint32_t  fb_size;        /* MZZ_FB_SIZE */
+	uint32_t  session;        /* attached session (valid if attached) */
+	uint32_t  done;           /* last KICK completed */
+	int       attached;
+	int       swapped;        /* REQ_MAGIC seen byte-swapped: refuse */
+	uint32_t  heartbeat;
+	uint32_t  ops;
+	uint32_t  rejected;
+	uint16_t  last_op;
+	void     *gfxdata;        /* private struct GFXData snapshot */
+};
+
+/* gfxdata must point at sizeof(struct GFXData) bytes (zz_service_gfxdata_size()). */
+void zz_service_init(struct zz_service *s, uint8_t *fb, uint32_t fb_size, void *gfxdata);
+unsigned zz_service_gfxdata_size(void);
+
+/* One mailbox check: attach to a new session, or run one pending op. */
+int  zz_service_poll(struct zz_service *s);
+
+/* Bump the heartbeat word (call every ~100ms while attached). */
+void zz_service_heartbeat(struct zz_service *s);
+
+#ifdef __cplusplus
+}
+#endif
