diff --git a/zz9000/amiga/rtg/build.sh b/zz9000/amiga/rtg/build.sh
new file mode 100755
index 00000000..fa60d270
--- /dev/null
+++ b/zz9000/amiga/rtg/build.sh
@@ -0,0 +1,11 @@
+#!/bin/sh
+set -eu
+
+if ! command -v m68k-amigaos-gcc >/dev/null 2>&1; then
+  script_dir=$(CDPATH='' cd -- "$(dirname -- "$0")" && pwd)
+  exec "$script_dir/../tools/amiga-docker.sh" rtg ./build.sh "$@"
+fi
+
+export PATH=/opt/amiga/bin:"$PATH"
+
+m68k-amigaos-gcc mntgfx-gcc.c -m68020 -mtune=68020-60 -O2 -I../include -o ZZ9000.card -noixemul -Wall -Wextra -Wno-unused-parameter -fomit-frame-pointer -nostartfiles -lamiga
