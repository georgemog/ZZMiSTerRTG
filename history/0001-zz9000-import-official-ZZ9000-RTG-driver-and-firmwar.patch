+
+static BOOL chars_equal_ci(char a, char b) {
+	if (a >= 'a' && a <= 'z')
+		a -= ('a' - 'A');
+	if (b >= 'a' && b <= 'z')
+		b -= ('a' - 'A');
+
+	return a == b;
+}
+
+static BOOL string_equal_ci(const char *a, const char *b) {
+	if (!a || !b)
+		return FALSE;
+
+	while (*a && *b) {
+		if (!chars_equal_ci(*a, *b))
+			return FALSE;
+		a++;
+		b++;
+	}
+
+	return *a == *b;
+}
