+// Optional dummy read for tricking the 68k cache on processors with occasional garbage output on screen
+#ifdef DUMMY_CACHE_READ
+	#define dmy_cache memcpy(dummies, (uint32_t *)(uint32_t)0x7F00000, 4);
+#else
+	#define dmy_cache
+#endif
