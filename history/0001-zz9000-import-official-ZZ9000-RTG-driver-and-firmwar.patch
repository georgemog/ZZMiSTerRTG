+	0,
+	(uint32_t)FindCard,
+	(uint32_t)InitCard,
+	-1
+};
+
+struct InitTable
+{
+	ULONG LibBaseSize;
+	APTR FunctionTable;
+	APTR DataTable;
+	APTR InitLibTable;
+};
